# Copy to .env and fill in. Never commit .env.

# Aevum testnet
RPC_URL=https://rpc-test.qday.info
CHAIN_ID=44005
EXPLORER_URL=https://explorer-test.qday.info
VAULT_ADDRESS=0x5E6f3d12AaeB6732840432D19BCc26a35e0F0184

# The agent's own hot wallet (testnet only). Make one with: cast wallet new
# Fund it with a little tQDAY for gas.
AGENT_PRIVATE_KEY=

# The webhook secret the Mesh Cloud shows for this organisation (portal, Webhook settings)
MESH_WEBHOOK_SECRET=

# Optional: enables POST /v1/vouchers for curl tests. Make one with: openssl rand -hex 24
TEST_API_KEY=

# Fee per voucher in tUSD8 units (6 decimals). 10000 = 0.01 tUSD8. Never above the signed maxFee.
FEE_UNITS=10000

# Wait this long for the transaction to be mined before answering "submitted" (Cloud timeout is 5 s)
CONFIRM_WAIT_MS=3000

# Host port the container listens on (127.0.0.1 only). Change if 8787 is taken.
AGENT_HOST_PORT=8787
