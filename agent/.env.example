# Copy to .env and fill in. Never commit .env.

# Aevum testnet
RPC_URL=https://rpc-test.qday.info
CHAIN_ID=44005
EXPLORER_URL=https://explorer-test.qday.info
VAULT_ADDRESS=0x5E6f3d12AaeB6732840432D19BCc26a35e0F0184

# The agent's own hot wallet (testnet only). Make one with: cast wallet new
# Fund it with a little tQDAY for gas.
AGENT_PRIVATE_KEY=

# The webhook secret the Mesh Cloud shows for this organisation (portal, Webhook settings)
MESH_WEBHOOK_SECRET=

# Optional: enables POST /v1/vouchers for curl tests. Make one with: openssl rand -hex 24
TEST_API_KEY=

# Fee per voucher in tUSD8 units (6 decimals). 10000 = 0.01 tUSD8. Never above the signed maxFee.
FEE_UNITS=10000

# Wait this long for the transaction to be mined before answering "submitted" (Cloud timeout is 5 s)
CONFIRM_WAIT_MS=3000

# Rails: limits that stop anyone burning the agent's gas
# Longest a voucher may stay valid, in seconds (7 days; offline payments can take a while to arrive)
MAX_VOUCHER_TTL_SEC=604800
# New vouchers per phone key per hour, and per gateway phone per hour
RATE_PER_SESSION_HOUR=30
RATE_PER_NODE_HOUR=120
# Owner actions (deposit, add or remove a phone key, withdraw) per wallet per hour, and the smallest deposit (0.1 tUSD8)
RATE_PER_OWNER_HOUR=20
MIN_DEPOSIT_UNITS=100000
# Settlement transactions and gas (wei) per UTC day. 50000000000000000 = 0.05 tQDAY
DAILY_TX_CAP=1000
DAILY_GAS_BUDGET_WEI=50000000000000000

# Activity page: the block the vault was deployed in
VAULT_FROM_BLOCK=3646498

# Host port the container listens on (127.0.0.1 only). Change if 8787 is taken.
AGENT_HOST_PORT=8787
